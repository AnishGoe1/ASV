<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>imu</name>
  <version>0.0.0</version>
  <description>Package to get data from the IMU sensor</description>
  <maintainer email="anishgoel1129@gmail.com">project</maintainer>
  <license>Apache-2.0</license>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>time</exec_depend>
  <exec_depend>csv</exec_depend>
  <exec_depend>os</exec_depend>
  <exec_depend>datetime</exec_depend>
  <exec_depend>signal</exec_depend>
  <exec_depend>board</exec_depend>
  <exec_depend>busio</exec_depend>
  <exec_depend>math</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
